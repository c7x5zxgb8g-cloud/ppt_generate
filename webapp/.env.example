PPT_MASTER_WEB_SECRET=change-this-to-a-long-random-string
PPT_MASTER_ALLOW_REGISTRATION=false

# Server-side AI runner for PPT text/layout/SVG generation.
PPT_MASTER_AGENT_RUNNER=api
PPT_MASTER_LLM_PROVIDER=openai-compatible
PPT_MASTER_LLM_API_KEY=sk-xxx
PPT_MASTER_LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
PPT_MASTER_LLM_MODEL=gpt-5.5

# Optional: dedicated DeepSeek API config just for image prompt refinement.
PPT_MASTER_IMAGE_PROMPT_REFINEMENT=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
PPT_MASTER_IMAGE_PROMPT_PROVIDER=openai-compatible
PPT_MASTER_IMAGE_PROMPT_API_KEY=${DEEPSEEK_API_KEY}
PPT_MASTER_IMAGE_PROMPT_BASE_URL=${DEEPSEEK_BASE_URL}
PPT_MASTER_IMAGE_PROMPT_MODEL=deepseek-chat

PPT_MASTER_REPAIR_ATTEMPTS=3
PPT_MASTER_DEFAULT_IMAGE_SIZE=512px

# Optional local development runners.
# PPT_MASTER_AGENT_RUNNER=codex
# PPT_MASTER_AGENT_RUNNER=claude

# Optional image acquisition, reused by PPT Master's original scripts.
IMAGE_BACKEND=openai
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
OPENAI_MODEL=gpt-image-2
PEXELS_API_KEY=
PIXABAY_API_KEY=
